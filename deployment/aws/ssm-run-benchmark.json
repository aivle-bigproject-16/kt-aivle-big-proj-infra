{
  "schemaVersion": "2.2",
  "description": "Run an observational Battery Inspection benchmark suite",
  "parameters": {
    "Suite": {
      "type": "String",
      "description": "Benchmark suite to run",
      "allowedValues": [
        "all",
        "inference",
        "vlm"
      ],
      "interpolationType": "ENV_VAR"
    },
    "Trigger": {
      "type": "String",
      "description": "Identifier stored with the benchmark result",
      "allowedPattern": "^[A-Za-z0-9_.@/-]{1,180}$",
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "runBenchmark",
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "flock -w 900 /var/lock/battery-deploy.lock /usr/local/bin/battery-post-deploy-benchmark --trigger \"$SSM_Trigger\" --suite \"$SSM_Suite\""
        ]
      }
    }
  ]
}
