# .env.example — 복사해서 .env 로 사용. .env 는 git 커밋 금지(.gitignore 등록됨).
# 개발값은 데모/로컬 전용. 배포 시 강한 시크릿으로 교체.

# ── PostgreSQL (메인 RDB, JSONB raw 포함) ──
POSTGRES_USER=battery
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=battery_inspection
POSTGRES_PORT=5432

# ── MongoDB (동작 로그 전용) ──
MONGO_INITDB_ROOT_USERNAME=battery
MONGO_INITDB_ROOT_PASSWORD=change_me_dev
MONGO_PORT=27017

# ── MinIO (개발 오브젝트 스토리지; 배포=AWS S3) ──
# MINIO_ROOT_PASSWORD 는 8자 이상 필수.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_dev_min8
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── S3 추상화 (boto3) ──
# 개발: 아래 MinIO 값 그대로. 배포: S3_ENDPOINT 비우고(=AWS 기본) 실 IAM 키로 교체.
# boto3.client("s3", endpoint_url=S3_ENDPOINT, aws_access_key_id=S3_ACCESS_KEY, ...)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=battery
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_dev_min8
S3_REGION=us-east-1
