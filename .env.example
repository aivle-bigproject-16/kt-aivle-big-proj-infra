# .env.example — 복사해서 .env 로 쓴다. .env 는 커밋 금지(.gitignore 가 .env* 를 막는다).
#
#   cp .env.example .env
#
# 개발값은 로컬 전용이다. 배포 시 강한 시크릿으로 바꾼다.
# 시크릿이 들어가는 항목은 값을 비워 뒀다. 각자 채운다.
#
# 2026-08-12 개정: 레지스트리를 ECR 로 옮겼고, ai-infer 변수 이름을 실제 코드
# (app/core/settings.py)에 맞췄다. 종전 DEVICE · MODEL_CT_KEY · MODEL_RGB_KEY 는
# ai-infer 가 읽지 않는 이름이었다. 전부 무시되고 기본값으로 떨어져 있었다.

# --- 기동 프로파일 -----------------------------------------------------------
# 비우면 redis 만 뜬다.
#   app        FE·BE 2종 (GPU 불필요)
#   stub       AI 스텁 (GPU 없는 BE 개발자용 고정 응답)
#   llm        vlm 단독
#   ai         ai-infer + vlm (GPU 필요)
# 예) COMPOSE_PROFILES=app,stub
COMPOSE_PROFILES=

# --- 이미지 레지스트리 (ECR) -------------------------------------------------
# 계정 825555019742 · 리전 ap-northeast-2.
# 푸시·풀 전에 로그인한다. 인증은 12시간 만료다.
#   aws ecr get-login-password --region ap-northeast-2 \
#     | docker login --username AWS --password-stdin 825555019742.dkr.ecr.ap-northeast-2.amazonaws.com
#
# EC2 에서는 액세스 키 대신 인스턴스 프로파일로 인증한다.
# 역할 kt-aivle-big-proj-ec2-ssm-role 에 AmazonEC2ContainerRegistryReadOnly 가 필요하다.
ECR_REGISTRY=825555019742.dkr.ecr.ap-northeast-2.amazonaws.com

# 서비스별 커밋 SHA 앞 7자리를 쓴다. latest fallback 은 두지 않는다.
# 값이 빠지면 compose 렌더링 단계에서 실패해 잘못된 이미지를 조용히 띄우지 않는다.
FRONTEND_TAG=590dfed
BACKEND_TAG=cf0dbbc
BACKEND_AI_TAG=cf0dbbc
AI_INFER_TAG=c233dc1
VLM_TAG=abfd37a

# --- 서빙 모드 ---------------------------------------------------------------
# live   : ai-infer 로 라이브 추론 (기본)
# replay : 저장된 과거 결과를 매칭키로 찾아 재생. GPU·추론 서버 사망 시 폴백.
#          라이브로 1회 완주해 DB 에 결과가 쌓여 있어야 동작한다.
SERVING_MODE=live

# --- 서비스 간 URL (런타임 HTTP. depends_on 아님) ----------------------------
# 호출 사슬:
#   frontend -> backend(8080) -> backend-ai(8081) -> ai-infer(8000) / vlm(8001)
#   ai-infer -> backend(8080) 로 콜백
#
# module-ai 는 셀 분석과 리포트 생성에 독립된 URL을 사용한다.
#   AiServerForwardService -> POST {AI_SERVER_URL}/ai/cells/analyze         = ai-infer
#   LlmWebClient           -> POST {LLM_SERVER_URL}/vlm/reports/individual  = vlm
AI_SERVER_URL=http://ai-infer:8000

AI_BASE_URL=http://ai-infer:8000
LLM_SERVER_URL=http://vlm:8001

# module-api -> module-ai. 변수 이름이 반드시 AI_GATEWAY_URL 이어야 한다.
# application.yml 이 ai-gateway.base-url: ${AI_GATEWAY_URL:...} 로 읽는다.
# 종전 이름 BACKEND_AI_BASE_URL 은 아무도 읽지 않아 리포트 생성이 전부 실패했다.
AI_GATEWAY_URL=http://backend-ai:8081

# ai-infer 가 분석 결과를 되돌려주는 주소.
# module-api 와 ai-infer 양쪽에 같은 값을 넣어야 한다. 다르면 ai-infer 가 400 을 낸다.
BACKEND_CALLBACK_URL=http://backend:8080/internal/ai/callbacks/cell

# --- 내부 호출 인증 ----------------------------------------------------------
# module-api · module-ai · ai-infer 세 곳이 공유한다.
# ai-infer 가 X-Internal-Api-Key 헤더로 검사하고 불일치 시 401 을 낸다.
# 비워 두면 내부 호출이 전부 막힌다.
AI_INTERNAL_API_KEY=

# --- BE 동시성·타임아웃 ------------------------------------------------------
AI_TIMEOUT_SECONDS=15      # 초과 시 판정 FAIL. 배치 내 다른 셀은 계속 간다
AI_POOL_SIZE=4             # 배치 하나 안의 셀 동시 호출 상한. 잠정값, 실측 후 확정
LLM_POOL_SIZE=2            # 생성 요청 동시 실행 상한

# --- Redis 타임아웃 ----------------------------------------------------------
# 지정하지 않으면 기본값이 60초라 캐시가 죽었을 때 화면이 60초 멈춘다.
# Redis 소켓 장애를 빠르게 감지하려면 이 두 값이 있어야 한다.
# 컨테이너 완전 중단 시 Docker DNS 지연은 별도이며, BE 결정 전 검증 상한은 임시 10초다.
REDIS_COMMAND_TIMEOUT=300ms
REDIS_CONNECT_TIMEOUT=200ms

# --- AI 추론 (ai-infer) ------------------------------------------------------
# 변수 이름 정본은 ai-infer 레포의 app/core/settings.py 다.
#
# INFERENCE_MODE 를 비우면 기본값이 stub 이다. 배포에서 고정 응답이 나가고
# 화면상으로는 정상으로 보이므로 아무도 눈치채지 못한다. 반드시 명시한다.
INFERENCE_MODE=onnx        # stub | ct-quality-onnx | ct-onnx | quality-onnx | rgb-onnx | onnx
ONNX_DEVICE=cuda           # cpu | cuda — GPU 없으면 cpu (느리지만 뜬다)

# 가중치 번들이 있는 호스트 경로. 컨테이너의 /models 로 읽기 전용 마운트된다.
# ai-infer 는 기동 시 S3 에서 내려받지 않는다. 미리 받아 두어야 한다.
# 번들 정본  : s3://kt-aivle-big-proj-kks/models/ai-infer/onnx-20260809-01/
# 목록·체크섬: ai-infer 레포의 deployment/model-manifest.json
# 내려받기  : ai-infer 레포의 scripts/fetch-model-bundle.sh (리눅스 배포 호스트용)
# 검증       : ai-infer 레포의 scripts/verify-model-manifest.ps1
# 총 용량    : 약 1.85 GB (rgb_owlv2 의 model.onnx.data 가 1.74 GB)
#
#   ./scripts/fetch-model-bundle.sh --target /opt/battery/models
#   MODELS_DIR=/opt/battery/models
#
# 주의: CT 결함 모델의 로컬 파일명은 defect_ct.torch211.onnx 다.
#       S3 키(defect_ct.onnx)와 다르고 settings.py 의 기본값과도 다르다.
#       compose 가 CT_DEFECT_MODEL_PATH 로 실제 이름을 명시한다.
MODELS_DIR=./models

# CT 후처리. 매니페스트의 runtime 값과 같아야 한다. 다르면 판정 결과가 달라진다.
CT_POSTPROCESS_TYPE=NMS            # NMS | GREEDYNMM
CT_POSTPROCESS_MATCH_METRIC=IOS    # IOU | IOS
CT_POSTPROCESS_MATCH_THRESHOLD=0.44

# 판정 임계값. 기본값은 모델 검증 시점의 운영점이다.
# CT_QUALITY_THRESHOLD 는 확률이 아니라 로짓이라 음수를 받는다.
CT_QUALITY_THRESHOLD=-0.6227158308029175
CT_DEFECT_CONF_THRESHOLD=0.05
RGB_QUALITY_FAIL_THRESHOLD=0.3
# FAIL 이미지 수 / 전체 이미지 수가 5% 이상일 때 셀 촬영실패로 판정
CELL_CAPTURE_FAIL_RATIO_THRESHOLD=0.05

# 이미지는 BE 가 발급한 presigned URL 로 ai-infer 가 직접 GET 한다.
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10
IMAGE_MAX_BYTES=20971520

# 콜백 재시도.
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_ATTEMPTS=3

# 동시 분석 워커와 대기열.
# g6e.xlarge 는 vCPU 가 4개뿐이고 CT 의 SAHI 타일링이 CPU 바운드다.
# 여기를 올리면 GPU 가 아니라 CPU 가 먼저 포화한다. 실측 전까지 기본값을 유지한다.
CELL_ANALYSIS_WORKERS=1
CELL_ANALYSIS_QUEUE_SIZE=4

# --- AI 스텁 (GPU 없는 개발자용) ---------------------------------------------
STUB_LATENCY_MS=800        # 라이브 추론 지연 흉내
STUB_REJECT_RATE=0.3       # REJECT 비율
STUB_FAIL_RATE=0.0

# --- 생성 모델 (vlm) ---------------------------------------------------------
# 모델 교체는 VLM_MODEL_ID 로만 한다. 비어 있으면 vlm 컨테이너가 뜨지 않는다.
#
# 배포 대상이 g6e.xlarge(L40S 48GB)로 확정됐다. 계약이 전제한 T4 16GB 가 아니다.
# T4 를 이유로 잡아둔 fp16 · 4bit 제약은 재검토 대상이다. L40S 는 bf16 을 지원한다.
# 양자화 설정은 성능 실측표의 "측정 환경" 열에 반드시 함께 적는다.
VLM_MODEL_ID=
VLM_QUANTIZATION=4bit      # none | 4bit | 8bit
VLM_DTYPE=fp16             # fp16 | bf16
# 게이트된 모델을 받을 때만 필요하다. 값이 없으면 등호 뒤를 완전히 비워 둔다.
# 값이 빈 줄에 인라인 주석을 붙이면 Compose 가 그 주석 문자열을 값으로 읽어 들인다.
# 값이 있는 줄과 달리 주석이 제거되지 않는다. 그렇게 들어간 한글 문자열이 그대로
# Authorization 헤더에 실려 huggingface_hub 요청이 UnicodeEncodeError 로 죽고,
# vlm 컨테이너가 기동 직후 재시작 루프에 빠진다. 2026-08-13 에 실제로 발생했다.
HUGGING_FACE_HUB_TOKEN=

# --- 데이터베이스 (Supabase PostgreSQL) --------------------------------------
# 관계형 DB 는 컨테이너로 띄우지 않는다. BE 가 Supabase 에 직접 붙는다.
# 접속 URL·계정은 BE application.yml 에 있고 여기서는 비밀번호만 준다.
# 주의: Supabase 리전은 ap-southeast-2, S3 는 ap-northeast-2 다. 왕복 지연이 붙는다.
DB_PASSWORD=

# --- 메일 (회원가입 이메일 인증, Gmail SMTP) ---------------------------------
# Gmail 은 계정 비밀번호가 아니라 앱 비밀번호를 쓴다.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 오브젝트 스토리지 (AWS S3 단독) -----------------------------------------
# 개발·배포 모두 실제 S3 를 쓴다. MinIO 는 폐기했다. 오프라인 개발은 불가능하다.
#
# S3_ENDPOINT 는 비워 둔다. 비어 있으면 SDK 가 리전 기본 엔드포인트를 쓴다.
# 값을 넣으면 그 주소로 강제된다. MinIO 시절의 잔재이므로 채우지 않는다.
#
# 주의: 아래 S3 변수는 backend(module-api) 전용이다.
#       ai-infer 는 S3 자격증명을 읽지 않는다. 가중치는 MODELS_DIR 마운트로 준다.
S3_ENDPOINT=
S3_BUCKET=kt-aivle-big-proj-kks
S3_REGION=ap-northeast-2

# 개발자 개인 IAM 사용자 키. 공유하지 않는다. 유출 시 본인 것만 회수한다.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- 인증 --------------------------------------------------------------------
JWT_SECRET=                # 32자 이상

# --- FE ----------------------------------------------------------------------
FRONTEND_PORT=80
