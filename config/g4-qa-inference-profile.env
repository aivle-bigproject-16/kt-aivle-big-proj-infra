# G4/T4 전용 1차 QA override. 운영 기본 profile로 승격하지 않는다.
CELL_MIN_VALID_COVERAGE=0.8
RGB_QUALITY_FAIL_THRESHOLD=0.915
RGB_CELL_REJECT_RATE_THRESHOLD=0.7
CT_QUALITY_GATE_MODE=shadow

# v2 porosity 3장 smoke 전 임시값. smoke 결과로 확정한다.
CT_DEFECT_CONF_THRESHOLD=0.05

# T4에서 동시 추론으로 인한 VRAM 압박을 피한다.
CELL_ANALYSIS_WORKERS=1
CELL_ANALYSIS_QUEUE_SIZE=4
